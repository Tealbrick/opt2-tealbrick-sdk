{
  "name": "@opt2-tealbrick/conformance",
  "version": "0.1.31",
  "private": true,
  "description": "Teal Brick opt2 conformance suite: checks + fake Portal + fake bridge generated from @opt2-tealbrick/spec.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "tb-conformance": "./dist/cli.js"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/run-tests.ts unit",
    "conformance": "node --run gen:check && node scripts/run-tests.ts conformance",
    "gen": "node scripts/gen-sdk-exports.ts",
    "gen:check": "node scripts/gen-sdk-exports.ts --check"
  },
  "dependencies": {
    "@opt2-tealbrick/spec": "https://github.com/Tealbrick/opt2-tealbrick-dist/releases/download/opt2-tealbrick-specs-spec-v0.1.70/opt2-tealbrick-spec-0.1.70.tgz",
    "@opt2-tealbrick/manifest": "workspace:*",
    "@opt2-tealbrick/miniapp-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
