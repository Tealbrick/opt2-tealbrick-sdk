{
  "name": "opt2-tealbrick-__APP_ID__",
  "version": "0.1.0",
  "private": true,
  "description": "__APP_NAME__: a Teal Brick opt2 miniapp.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#kit": "./dist/kit/index.js"
  },
  "scripts": {
    "kit": "tb-gen kit && tsc -p gen/kit/__APP_ID__-kit --outDir dist/kit",
    "start": "node --run kit && node src/main.ts",
    "typecheck": "node --run kit && tsc --noEmit",
    "lint": "biome check . && check-system src",
    "test": "node --run kit && node --test 'test/**/*.test.ts'",
    "conformance": "node --run kit && tb-conformance app --start conformance.start.ts --manifest tealbrick.manifest.json --test-roots",
    "build": "node --run kit && tsc -p tsconfig.build.json && node scripts/build-ui.ts",
    "gen": "tb-gen all"
  },
  "dependencies": {
    "@opt2-tealbrick/manifest": "https://github.com/Tealbrick/opt2-tealbrick-dist/releases/download/opt2-tealbrick-sdk-manifest-v0.1.25/opt2-tealbrick-manifest-0.1.25.tgz",
    "@opt2-tealbrick/miniapp-sdk": "https://github.com/Tealbrick/opt2-tealbrick-dist/releases/download/opt2-tealbrick-sdk-miniapp-sdk-v0.1.31/opt2-tealbrick-miniapp-sdk-0.1.31.tgz"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@opt2-tealbrick/conformance": "https://github.com/Tealbrick/opt2-tealbrick-dist/releases/download/opt2-tealbrick-sdk-conformance-v0.1.22/opt2-tealbrick-conformance-0.1.22.tgz",
    "@opt2-tealbrick/ui": "https://github.com/Tealbrick/opt2-tealbrick-dist/releases/download/opt2-tealbrick-packages-ui-v0.3.0/opt2-tealbrick-ui-0.3.0.tgz",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
